# Optional. NYC Open Data app token raises Socrata rate limits. https://data.cityofnewyork.us/profile/edit/developer_settings
VITE_SOCRATA_APP_TOKEN=
# Optional. Where the citywide build's cells are served; without it everything loads live.
# Locally, after `pnpm download && pnpm build-cells`, use /cells; otherwise the R2 bucket's public URL.
VITE_CELLS_URL=
