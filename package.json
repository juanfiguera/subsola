{
  "name": "subsola",
  "version": "1.0.0",
  "description": "Underground utilities, mapped from public records",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc && tsc -p pipeline && tsc -p tests && tsc -p functions && tsc -p workers/health",
    "download": "tsx pipeline/download.ts",
    "build-cells": "tsx pipeline/build.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:visual": "playwright test",
    "upload-cells": "tsx --env-file-if-exists=.env.r2 pipeline/upload.ts",
    "download-osm": "tsx pipeline/osm.ts",
    "insights": "tsx pipeline/insights.ts",
    "archive-toronto": "tsx --env-file-if-exists=.env.r2 pipeline/archive/toronto.ts",
    "models": "blender -b -P models/hydrant.py -- public/models && blender -b -P models/signal.py -- public/models"
  },
  "author": "",
  "license": "AGPL-3.0-only",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.0.9",
      "onFail": "download"
    }
  },
  "type": "module",
  "dependencies": {
    "@deck.gl/core": "^9.4.0",
    "@deck.gl/layers": "^9.4.0",
    "@deck.gl/mesh-layers": "9.4.0",
    "@loaders.gl/core": "4.5.4",
    "@resvg/resvg-wasm": "2.6.2",
    "@sentry/browser": "^11.10.0",
    "maplibre-gl": "^6.15.0",
    "posthog-js": "^1.447.3",
    "proj4": "^2.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.20.5",
    "@types/proj4": "^2.19.0",
    "aws4fetch": "1.0.20",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "undici": "6.24.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.158.0"
  },
  "private": true
}
